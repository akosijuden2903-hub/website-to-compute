<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monthsary Surprise</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;700&display=swap');
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
        @keyframes heartBeat {
            0% { transform: scale(1); }
            14% { transform: scale(1.3); }
            28% { transform: scale(1); }
            42% { transform: scale(1.3); }
            70% { transform: scale(1); }
        }
        
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #ffd6e0 0%, #fff5f7 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }
        
        .chibi-character {
            animation: float 6s ease-in-out infinite;
            filter: drop-shadow(0 10px 8px rgba(0,0,0,0.1));
        }
        
        .heart {
            animation: pulse 2s infinite;
            cursor: pointer;
        }
        
        .heart:hover {
            animation: heartBeat 1.5s infinite;
        }
        
        .message-box {
            background: rgba(255,255,255,0.8);
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }
        
        .confetti {
            position: absolute;
            width: 10px;
            height: 10px;
            background-color: #f00;
            opacity: 0;
        }
        
        .polaroid {
            background: white;
            padding: 15px 15px 60px 15px;
            filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));
            transform: rotate(-2deg);
            transition: all 0.3s ease;
        }
        
        .polaroid:hover {
            transform: rotate(2deg) scale(1.05);
        }
        
        .memory {
            transform: scale(0.95);
            opacity: 0;
            transition: all 0.5s ease;
        }
        
        .memory.active {
            transform: scale(1);
            opacity: 1;
        }
    </style>
</head>
<body class="relative">
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none" id="confetti-container"></div>
    
    <div class="container mx-auto px-4 py-12 flex flex-col items-center min-h-screen">
        <!-- Header with animated title -->
        <header class="text-center mb-8">
            <h1 class="text-4xl md:text-5xl font-bold text-pink-600 mb-2 transform hover:scale-105 transition duration-300">
                <span class="inline-block hover:text-purple-600">Happy</span> 
                <span class="inline-block hover:text-red-500">Monthsary</span> 
                <span class="inline-block hover:text-yellow-500">❤️</span>
            </h1>
            <p class="text-lg text-gray-600">Our special day together</p>
        </header>
        
        <!-- Main content area -->
        <main class="flex flex-col lg:flex-row items-center justify-center gap-12 w-full">
            <!-- Chibi character display -->
            <div class="relative flex-shrink-0">
                <div class="chibi-character w-64 h-64 md:w-80 md:h-80 relative">
                    <img src="https://placehold.co/600x600" alt="Cute anime-style chibi couple holding hands with sparkles around them in pastel colors" class="w-full h-full object-contain" id="character-img">
                </div>
                <div class="absolute -bottom-6 left-1/2 transform -translate-x-1/2 bg-white bg-opacity-80 rounded-full px-6 py-2 text-sm shadow-md flex items-center gap-2">
                    <span>Click hearts!</span>
                    <div class="heart" id="heart-icon">❤️</div>
                </div>
            </div>
            
            <!-- Interactive message area -->
            <div class="message-box rounded-2xl p-6 md:p-8 max-w-md w-full shadow-lg flex flex-col">
                <div class="text-center mb-6">
                    <h2 class="text-2xl font-bold text-pink-500 mb-2">To My Love</h2>
                    <div class="w-16 h-1 bg-pink-200 mx-auto"></div>
                </div>
                
                <div class="flex-grow mb-6">
                    <p class="text-gray-700 mb-4">Every day with you feels magical. Here's to many more years of laughter, love, and adventure together!</p>
                    
                    <div class="text-center mb-6">
                        <button id="surprise-btn" class="px-6 py-2 bg-pink-500 text-white rounded-full hover:bg-pink-600 transform hover:scale-105 transition duration-300 shadow-md">
                            Click for Surprise!
                        </button>
                    </div>
                    
                    <!-- Hidden memories that will appear -->
                    <div class="memory" id="memory1">
                        <div class="polaroid">
                            <img src="https://placehold.co/400x300" alt="Cute chibi version of our first date at the amusement park" class="w-full h-auto">
                            <p class="text-center mt-2 text-sm">Our First Date</p>
                        </div>
                    </div>
                    
                    <div class="memory" id="memory2">
                        <div class="polaroid">
                            <img src="https://placehold.co/400x300" alt="Chibi style beach vacation with us building a sandcastle" class="w-full h-auto">
                            <p class="text-center mt-2 text-sm">Beach Vacation</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex justify-between items-center">
                    <div class="text-xs text-gray-500">Made with love ❤️</div>
                    <button id="change-character" class="text-sm text-pink-600 hover:text-pink-800">
                        Change Avatar
                    </button>
                </div>
            </div>
        </main>
        
        <!-- Countdown area -->
        <div class="mt-12 text-center bg-white bg-opacity-70 rounded-2xl p-6 shadow-md">
            <h3 class="text-xl font-semibold text-gray-700 mb-4">Our Journey</h3>
            <div class="flex justify-center gap-6 text-center">
                <div class="bg-pink-100 rounded-lg p-3 w-20">
                    <div class="text-2xl font-bold text-pink-600" id="years">0</div>
                    <div class="text-xs text-gray-600">Years</div>
                </div>
                <div class="bg-purple-100 rounded-lg p-3 w-20">
                    <div class="text-2xl font-bold text-purple-600" id="days">0</div>
                    <div class="text-xs text-gray-600">Days</div>
                </div>
                <div class="bg-yellow-100 rounded-lg p-3 w-20">
                    <div class="text-2xl font-bold text-yellow-600" id="hours">0</div>
                    <div class="text-xs text-gray-600">Hours</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Configuration
        const characterImages = [
            "https://placehold.co/600x600",
            "https://placehold.co/600x600",
            "https://placehold.co/600x600"
        ];
        
        const characterAlts = [
            "Sweet anime chibi couple hugging under a cherry blossom tree",
            "Playful chibi versions of us dressed in matching outfits",
            "Romantic chibi scene with us slow dancing under starry sky"
        ];
        
        // State
        let currentCharacter = 0;
        let memoryIndex = 0;
        
        // DOM Elements
        const characterImg = document.getElementById('character-img');
        const heartIcon = document.getElementById('heart-icon');
        const surpriseBtn = document.getElementById('surprise-btn');
        const changeCharBtn = document.getElementById('change-character');
        const confettiContainer = document.getElementById('confetti-container');
        
        // Countdown elements
        const yearsEl = document.getElementById('years');
        const daysEl = document.getElementById('days');
        const hoursEl = document.getElementById('hours');
        
        // Date setup (edit this with your anniversary date)
        const anniversaryDate = new Date();
        anniversaryDate.setMonth(anniversaryDate.getMonth() - 1); // Example: 1 month ago
        
        // Initialize
        updateCountdown();
        setInterval(updateCountdown, 3600000); // Update every hour
        
        // Event Listeners
        heartIcon.addEventListener('click', createHearts);
        surpriseBtn.addEventListener('click', revealSurprise);
        changeCharBtn.addEventListener('click', changeCharacter);
        
        // Functions
        function updateCountdown() {
            const now = new Date();
            const diff = now - anniversaryDate;
            
            const years = Math.floor(diff / (1000 * 60 * 60 * 24 * 365));
            const days = Math.floor((diff % (1000 * 60 * 60 * 24 * 365)) / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            
            yearsEl.textContent = years;
            daysEl.textContent = days;
            hoursEl.textContent = hours;
        }
        
        function createHearts() {
            // Create 10 hearts with random properties
            for (let i = 0; i < 10; i++) {
                const heart = document.createElement('div');
                heart.classList.add('heart', 'absolute');
                heart.style.left = `${Math.random() * 100}%`;
                heart.style.top = `${Math.random() * 100}%`;
                heart.style.fontSize = `${Math.random() * 20 + 10}px`;
                heart.style.color = `hsl(${Math.random() * 60 + 330}, 100%, 70%)`;
                heart.textContent = '❤️';
                
                document.body.appendChild(heart);
                
                // Animate heart
                const animationDuration = Math.random() * 3 + 2;
                heart.style.animation = `float ${animationDuration}s ease-in forwards`;
                
                // Remove heart after animation
                setTimeout(() => {
                    heart.remove();
                }, animationDuration * 1000);
            }
        }
        
        function revealSurprise() {
            // Show next memory
            const memories = document.querySelectorAll('.memory');
            
            if (memoryIndex < memories.length) {
                memories[memoryIndex].classList.add('active');
                memoryIndex++;
                
                // Change button text or hide if all memories shown
                if (memoryIndex >= memories.length) {
                    surpriseBtn.textContent = 'No More Surprises!';
                    surpriseBtn.disabled = true;
                } else {
                    surpriseBtn.textContent = 'Next Surprise!';
                }
            }
            
            // Create confetti
            createConfetti();
        }
        
        function changeCharacter() {
            currentCharacter = (currentCharacter + 1) % characterImages.length;
            characterImg.src = characterImages[currentCharacter];
            characterImg.alt = characterAlts[currentCharacter];
            
            // Add bounce effect
            characterImg.style.animation = 'none';
            setTimeout(() => {
                characterImg.style.animation = 'float 6s ease-in-out infinite';
            }, 10);
        }
        
        function createConfetti() {
            // Clear existing confetti
            confettiContainer.innerHTML = '';
            
            // Create 50 confetti pieces
            for (let i = 0; i < 50; i++) {
                const confetti = document.createElement('div');
                confetti.classList.add('confetti');
                
                // Random properties
                confetti.style.left = `${Math.random() * 100}%`;
                confetti.style.backgroundColor = `hsl(${Math.random() * 360}, 100%, 70%)`;
                confetti.style.width = `${Math.random() * 10 + 5}px`;
                confetti.style.height = `${Math.random() * 10 + 5}px`;
                confetti.style.borderRadius = `${Math.random() * 5}px`;
                
                // Animation
                const animationDuration = Math.random() * 3 + 2;
                confetti.style.animation = `
                    confettiFall ${animationDuration}s linear forwards,
                    confettiSpin ${animationDuration}s linear infinite
                `;
                
                // Keyframe animation definitions
                const style = document.createElement('style');
                style.textContent = `
                    @keyframes confettiFall {
                        0% {
                            transform: translateY(-100vh) rotate(0deg);
                            opacity: 1;
                        }
                        100% {
                            transform: translateY(100vh) rotate(360deg);
                            opacity: 0;
                        }
                    }
                    @keyframes confettiSpin {
                        0% { transform: rotate(0deg); }
                        100% { transform: rotate(360deg); }
                    }
                `;
                document.head.appendChild(style);
                
                confettiContainer.appendChild(confetti);
                
                // Remove confetti after animation
                setTimeout(() => {
                    confetti.remove();
                    style.remove();
                }, animationDuration * 1000);
            }
        }
    </script>
</body>
</html>
